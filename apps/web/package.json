{
  "name": "@subscribby/web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:mock": "node --env-file-if-exists=mock-api/.env --watch mock-api/src/server.js",
    "dev:all": "concurrently -k -n mock,web -c magenta,cyan \"npm:dev:mock\" \"npm:dev\"",
    "mock": "node --env-file-if-exists=mock-api/.env mock-api/src/server.js",
    "mock:smoke": "node --env-file-if-exists=mock-api/.env mock-api/scripts/smoke.mjs",
    "staff-path": "node scripts/staff-path.mjs",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b",
    "lint": "oxlint src",
    "preview": "vite preview"
  },
  "dependencies": {
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@hookform/resolvers": "^6.0.2",
    "@mantine/core": "^9.7.4",
    "@mantine/dates": "^9.7.4",
    "@mantine/hooks": "^9.7.4",
    "@mantine/notifications": "^9.7.4",
    "@tabler/icons-react": "^3.50.0",
    "@tanstack/react-query": "^5.105.0",
    "dayjs": "^1.11.23",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.91.0",
    "react-router": "^8.5.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tanstack/react-query-devtools": "^5.105.0",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "csv-parse": "^7.0.3",
    "express": "^5.3.0",
    "multer": "^2.5.0",
    "oxlint": "^1.89.0",
    "postcss": "^8.5.32",
    "postcss-preset-mantine": "^1.18.0",
    "postcss-simple-vars": "^7.0.1",
    "typescript": "~7.0.2",
    "vite": "^8.3.5"
  },
  "description": "Subscribby web app: customer site and staff console",
  "engines": {
    "node": ">=22.9"
  }
}
