# Base path the app calls. Keep /api/v1: in dev Vite proxies it, in production CloudFront routes it.
VITE_API_BASE_URL=/api/v1

# Where the Vite dev server forwards /api calls. Mock API now, real backend later (same port).
VITE_API_PROXY_TARGET=http://localhost:4000

# SHA-256 of the secret staff console path segment (the console lives at /<segment>/login).
# Never put the segment itself here. Generate both with `npm run staff-path` (run in apps/web).
VITE_STAFF_PATH_HASH=
