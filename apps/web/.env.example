# Base path the app calls. Keep /api/v1: in dev Vite proxies it, in production Vercel rewrites it.
VITE_API_BASE_URL=/api/v1

# Where the dev server forwards /api calls.
# Live backend (default). For a local backend or the built-in mock (npm run dev:all) use http://localhost:4000
VITE_API_PROXY_TARGET=http://subscribby-api-env.eba-xyim8qvr.ap-south-1.elasticbeanstalk.com

# SHA-256 of the staff console path segment (the console lives at /<segment>/login).
# This value matches the live site. Run `npm run staff-path` to make your own.
VITE_STAFF_PATH_HASH=6244ce05ddc80c7733fd937441eb5536f1ee058fac3e3dbface995464908b13c
